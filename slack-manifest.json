{
    "display_information": { "name": "Personal Agents" },
    "features": {
        "bot_user": { "display_name": "Assistant", "always_online": false }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "chat:write",
                "channels:history",
                "channels:read",
                "groups:history"
            ]
        }
    },
    "settings": {
        "socket_mode_enabled": true,
        "event_subscriptions": {
            "bot_events": ["app_mention", "message.channels", "message.groups"]
        }
    }
}
