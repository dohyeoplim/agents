{
    "display_information": { "name": "Personal Agents" },
    "features": {
        "agent_view": {
            "agent_description": "A personal assistant for research, writing, coding and planning."
        },
        "bot_user": { "display_name": "Assistant", "always_online": true }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "assistant:write",
                "chat:write",
                "chat:write.customize",
                "channels:history",
                "channels:read",
                "channels:join",
                "groups:read",
                "files:read",
                "bookmarks:read",
                "canvases:read",
                "groups:history"
            ]
        }
    },
    "settings": {
        "socket_mode_enabled": true,
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "message.channels",
                "message.groups",
                "channel_created",
                "member_joined_channel",
                "agent_session_title_changed"
            ]
        }
    }
}
